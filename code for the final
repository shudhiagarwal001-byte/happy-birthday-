<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Happy Birthday!</title>
  <style>
    :root { --ink:#dbe8ff; --pink:#75c7ff; --cream:#f4f8ff; --gold:#ffd166; --purple:#8f7cff; --navy:#06152f; --deep:#020817; --blue:#163d78; }
    @font-face { font-family:'Bliss Sureal'; src:url('font-package/NCLBlissSureal-Demo.otf') format('opentype'); font-display:swap; }
    @font-face { font-family:'Runethia'; src:url('runethia-font/Runethia.otf') format('opentype'); font-display:swap; }
    * { box-sizing:border-box; }
    body { margin:0; min-height:100vh; overflow:auto; color:var(--ink); font-family:'Palatino Linotype', Palatino, Georgia, serif; background:radial-gradient(circle at 19% 15%,#1d579e 0 0.7%,transparent 1.2%),radial-gradient(circle at 80% 70%,#375fbd 0 .55%,transparent 1%),radial-gradient(circle at 30% 75%,#fff 0 .35%,transparent .7%),radial-gradient(ellipse at bottom,#123c76 0%,var(--navy) 48%,var(--deep) 100%); }
    body:before { content:''; position:fixed; inset:0; opacity:.7; pointer-events:none; background-image:radial-gradient(#fff 1px,transparent 1px),radial-gradient(#b8dcff 1px,transparent 1px); background-size:79px 79px,131px 131px; background-position:19px 37px,63px 82px; }
    .orbit { position:fixed; border-radius:50%; border:1px solid #7fc9ff5c; pointer-events:none; }
    .o1 { width:65vmax;height:65vmax; left:-32vmax;top:-24vmax; } .o2 { width:50vmax;height:50vmax;right:-25vmax;bottom:-28vmax; }
    main { min-height:100vh; display:grid; place-items:center; padding:24px; position:relative; }
    .card { width:min(760px,100%); text-align:center; padding:clamp(34px,7vw,70px) clamp(24px,7vw,76px); border:1px solid #79c7ff73; border-radius:32px; background:#061a3de6; box-shadow:0 26px 70px #000b; backdrop-filter:blur(10px); }
    .screen { display:none; position:relative; } .screen.active { display:block; animation:appear .4s ease both; }
    .page-doodle { position:absolute; z-index:1; top:-12px; right:-13px; width:76px; height:76px; border:2px solid #b9def4; border-radius:14px; background-color:#fff; background-image:url('cat-doodle-sheet.jpeg'); background-size:400% 600%; box-shadow:0 5px 12px #0005; transform:rotate(7deg); pointer-events:none; } .doodle-happy { background-position:66.67% 33.33%; } .doodle-question { background-position:33.33% 16.67%; } .doodle-dare { background-position:100% 0; } .doodle-letter { background-position:33.33% 66.67%; border-color:#a78342; transform:rotate(7deg) scale(.83); top:-5px; right:-5px; } .doodle-final { background-position:0 83.33%; }
    .eyebrow { margin:0 0 18px; color:#9cd9ff; font:700 .78rem/1.2 Arial,sans-serif; letter-spacing:.18em; text-transform:uppercase; }
    h1 { margin:0; padding:15px 0 17px; font-family:'Palatino Linotype', Palatino, Georgia, serif; font-size:clamp(3rem,9vw,6.2rem); font-weight:normal; line-height:.86; letter-spacing:-.05em; color:#f5fbff; }
    h1 span { display:block; color:#8bd3ff; font-size:.56em; letter-spacing:-.04em; margin-top:.18em; }
    .cake { position:relative; display:inline-block; font-size:4.6rem; margin:24px 0 12px; filter:drop-shadow(0 7px 5px #5f32502b); animation:bob 2.5s ease-in-out infinite; }
    .cake-base { display:block; } .candles { position:absolute; z-index:1; left:50%; top:-19px; font-size:1.3rem; letter-spacing:-.55rem; transform:translateX(-50%); filter:drop-shadow(0 0 5px #ffcd62); animation:flicker .8s ease-in-out infinite alternate; }
    .cake.blown { filter:grayscale(.45) drop-shadow(0 7px 5px #5f32502b); animation:blow .85s ease forwards; } .cake.blown .candles { animation:extinguish .5s ease forwards; }
    .message { max-width:520px; margin:0 auto 25px; font-size:clamp(1.05rem,2.6vw,1.28rem); line-height:1.55; }
    button { appearance:none; border:1px solid #93d4ff; border-radius:999px; background:#1266af; color:white; font:700 .9rem Arial,sans-serif; letter-spacing:.04em; padding:15px 23px; cursor:pointer; box-shadow:0 8px 0 #082d5a; transition:transform .15s, box-shadow .15s; }
    button:hover { transform:translateY(-2px); box-shadow:0 10px 0 #082d5a; } button:active { transform:translateY(6px); box-shadow:0 2px 0 #082d5a; }
    .from { margin:30px 0 0; color:#9cc9ed; font-style:italic; }
    .question { font:400 clamp(2.3rem,7vw,4.25rem)/1.02 'Palatino Linotype', Palatino, Georgia, serif; letter-spacing:-.02em; text-transform:uppercase; margin:0 0 34px; color:#d8edff; }
    .choices { display:flex; justify-content:center; gap:14px; flex-wrap:wrap; } .yes { background:#7e62db; border-color:#b7a9ff; box-shadow:0 8px 0 #47338f; } .yes:hover { box-shadow:0 10px 0 #47338f; } .yes:active { box-shadow:0 2px 0 #47338f; }
    .dory { margin:-10px auto 18px; color:#9ee4ff; font:italic 1.04rem/1.3 Georgia,serif; } .dory span { display:inline-block; font-size:3rem; vertical-align:middle; margin-right:7px; animation:swim 2.7s ease-in-out infinite; }
    .mad-cat { display:block; width:min(190px,62vw); margin:-10px auto 24px; border:4px solid #89d2ff; border-radius:18px; box-shadow:0 12px 28px #0009; transform:rotate(-2deg); cursor:pointer; transition:transform .2s,box-shadow .2s; } .mad-cat:hover { transform:rotate(2deg) scale(1.04); box-shadow:0 15px 34px #000c; }
    #dare .question { font-family:'Palatino Linotype', Palatino, Georgia, serif; letter-spacing:.01em; text-transform:none; color:#d8efff; }
    .royal-letter { position:relative; max-width:600px; margin:auto; padding:clamp(28px,6vw,54px); color:#302114; text-align:left; border:10px double #7a5a25; border-radius:4px; background:radial-gradient(circle at 18% 18%,#fff9da 0 1%,transparent 20%),linear-gradient(135deg,#f4e2ad,#fff6d8 48%,#e9cd91); box-shadow:inset 0 0 0 3px #b28a3f,0 16px 42px #0009; font-family:'Runethia','Palatino Linotype',Palatino,Georgia,serif; }
    .royal-letter:before,.royal-letter:after { content:'✦'; position:absolute; color:#866524; font-size:1.65rem; } .royal-letter:before { top:10px; left:13px; } .royal-letter:after { right:13px; bottom:10px; }
    .doodle { position:absolute; color:#947134; opacity:.72; pointer-events:none; font-family:'Palatino Linotype',Palatino,Georgia,serif; } .doodle.star { top:22px; right:23px; font-size:1.45rem; } .doodle.moon { bottom:23px; left:25px; font-size:1.8rem; } .doodle.heart { top:45%; right:17px; font-size:1.25rem; transform:rotate(12deg); } .doodle.line { left:20px; top:38%; font-size:1.1rem; letter-spacing:-.2em; transform:rotate(-18deg); }
    .letter-kicker { margin:0 0 20px; color:#80601f; font:700 .72rem/1 Arial,sans-serif; letter-spacing:.2em; text-align:center; text-transform:uppercase; }
    .royal-letter h2 { margin:0 0 22px; color:#3a2814; font:normal clamp(2.3rem,7vw,4rem)/.95 'Palatino Linotype',Palatino,Georgia,serif; text-align:center; letter-spacing:-.04em; }
    .royal-letter p { font-size:clamp(1.05rem,2.8vw,1.25rem); line-height:1.65; margin:0 0 17px; } .signature { margin:25px 0 0!important; color:#51371d; font-style:italic; text-align:right; }
    .seal { width:52px; height:52px; display:grid; place-items:center; margin:26px auto 0; padding:0; border:0; border-radius:50%; background:#872f31; color:#ffd982; font:1.7rem Georgia,serif; box-shadow:inset 0 0 0 3px #b85650,0 3px 0 #552226; cursor:pointer; } .seal:hover { transform:translateY(-2px) rotate(-6deg); box-shadow:inset 0 0 0 3px #b85650,0 5px 0 #552226; } .seal:active { transform:translateY(2px); box-shadow:inset 0 0 0 3px #b85650,0 1px 0 #552226; }
    .final-note { padding:30px 14px; } .final-note h2 { margin:0 0 16px; color:#ffe4a2; font:normal clamp(2.4rem,8vw,4.5rem)/.95 'Palatino Linotype', Palatino, Georgia, serif; } .final-note p { max-width:410px; margin:0 auto; color:#cfe8ff; font-size:1.2rem; line-height:1.6; }
    .photo-gallery { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; max-width:490px; margin:26px auto 20px; } .photo-button { padding:0; border:2px solid #d8b558; border-radius:12px; background:none; box-shadow:none; overflow:hidden; position:relative; } .photo-button:hover { transform:translateY(-3px); box-shadow:0 8px 20px #0008; } .photo-button:active { transform:translateY(1px); box-shadow:none; } .photo-button img { display:block; width:100%; aspect-ratio:3/4; object-fit:cover; } .photo-name { position:absolute; inset:auto 0 0; padding:10px 4px; background:linear-gradient(transparent,#171006dc); color:#ffd976; font:normal 1.9rem/1 'Palatino Linotype',Palatino,Georgia,serif; letter-spacing:.05em; text-shadow:0 1px #513713; }
    .small-seal { transform:scale(.8); margin:-2px auto 0; } .small-seal:hover { transform:translateY(-2px) rotate(-6deg) scale(.8); } .small-seal:active { transform:translateY(2px) scale(.8); }
    .lightbox { position:fixed; z-index:10; inset:0; display:none; place-items:center; padding:24px; background:#010613dc; cursor:zoom-out; } .lightbox.open { display:grid; } .lightbox img { max-width:min(92vw,720px); max-height:88vh; border:3px solid #e7f5ff; border-radius:12px; box-shadow:0 18px 60px #000; }
    .cat-sticker { position:fixed; z-index:12; top:-80px; width:clamp(46px,9vw,82px); height:clamp(58px,12vw,105px); object-fit:cover; border:3px solid #ffe494; border-radius:12px; pointer-events:none; box-shadow:0 5px 12px #0009; animation:fall var(--d) linear forwards; }
    .smoke { position:fixed; z-index:9; width:14px; height:14px; border-radius:50%; background:#e7f4ffb8; pointer-events:none; filter:blur(1px); animation:smoke 1.7s ease-out forwards; }
    .space-board { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; text-align:left; margin:30px 0; }
    .meme { min-height:150px; padding:18px; border:1px solid #5bb2ec85; border-radius:18px; background:linear-gradient(135deg,#0f3d7c,#081d42); position:relative; overflow:hidden; }
    .meme .cat { display:block; font-size:3.8rem; line-height:1; margin-bottom:9px; transform:rotate(-7deg); } .meme strong { display:block; color:#fff; font:700 .85rem/1.25 Arial,sans-serif; text-transform:uppercase; letter-spacing:.04em; }
    .meme small { color:#abd9ff; font:italic .86rem/1.35 Georgia,serif; }
    .gt3 { grid-column:1/-1; min-height:190px; padding:22px; border:1px solid #ffd1668a; border-radius:18px; background:linear-gradient(110deg,#06182f,#102d60 60%,#351f48); overflow:hidden; position:relative; }
    .gt3:after { content:'✦'; color:#ffe087; font-size:8rem; opacity:.18; position:absolute; right:8%; top:4%; } .car { font-size:5.2rem; float:right; margin:12px 2% 0 18px; filter:drop-shadow(0 10px 7px #000); }
    .gt3 h2 { color:#ffe09a; margin:0 0 6px; font:700 clamp(1.45rem,5vw,2.4rem) Arial,sans-serif; letter-spacing:-.06em; } .gt3 p { max-width:410px; margin:0; color:#cce9ff; line-height:1.45; }
    .fries { position:fixed; top:-60px; font-size:clamp(1.5rem,3vw,2.5rem); pointer-events:none; animation:fall var(--d) linear forwards; filter:drop-shadow(0 4px 3px #0006); }
    /* Added surprise journey — edit media paths and captions in the script at the bottom. */
    .surprise-menu,.surprise-gallery,.surprise-stage,.surprise-video { text-align:center; }
    .surprise-menu h2,.surprise-stage h2,.surprise-video h2 { margin:0; color:#f7fbff; font:normal clamp(2.6rem,8vw,5rem)/.95 'Palatino Linotype',Palatino,Georgia,serif; letter-spacing:-.05em; }
    .surprise-menu p,.surprise-stage p,.surprise-video p { max-width:520px; margin:19px auto 0; color:#cfe8ff; font-size:clamp(1rem,2.7vw,1.22rem); line-height:1.55; }
    .surprise-letters { display:flex; justify-content:center; gap:18px; flex-wrap:wrap; margin-top:34px; }
    .surprise-letter { display:grid; place-items:center; width:clamp(74px,16vw,104px); height:clamp(74px,16vw,104px); padding:0; border-radius:28px; background:linear-gradient(135deg,#1266af,#7e62db); font-size:clamp(1.5rem,5vw,2.1rem); }
    .gallery-heading { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:24px; text-align:left; }.gallery-heading h2 { margin:0; color:#f7fbff; font:normal clamp(2rem,7vw,3.8rem)/.95 'Palatino Linotype',Palatino,Georgia,serif; }.gallery-heading .surprise-letter { flex:0 0 auto; width:52px; height:52px; border-radius:17px; font-size:1.15rem; }
    .surprise-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(185px,1fr)); gap:14px; }.surprise-photo { padding:0; overflow:hidden; border:1px solid #a7dcff9c; border-radius:16px; background:#0a2450; text-align:left; box-shadow:none; }.surprise-photo:hover { box-shadow:0 12px 25px #0008; }.surprise-photo img { display:block; width:100%; aspect-ratio:4/5; object-fit:cover; transition:transform .3s ease; }.surprise-photo:hover img { transform:scale(1.06); }.surprise-photo span { display:block; padding:10px 12px; color:#f2f9ff; font:1rem/1.35 Arial,sans-serif; }
    .surprise-lightbox { position:fixed; z-index:30; inset:0; display:none; place-items:center; padding:22px; background:#010613e8; backdrop-filter:blur(8px); }.surprise-lightbox.open { display:grid; animation:appear .25s ease both; }.surprise-lightbox figure { max-width:min(820px,84vw); max-height:90vh; margin:0; text-align:center; }.surprise-lightbox img { display:block; max-width:100%; max-height:73vh; margin:auto; border:3px solid #e7f5ff; border-radius:13px; box-shadow:0 18px 60px #000; }.surprise-lightbox figcaption { margin-top:13px; color:white; font-size:clamp(1rem,3vw,1.25rem); }.lightbox-control { position:absolute; z-index:1; width:45px; height:45px; padding:0; border-radius:50%; font-size:1.8rem; line-height:1; }.lightbox-close { top:17px; right:18px; }.lightbox-prev { left:clamp(10px,4vw,44px); top:50%; }.lightbox-next { right:clamp(10px,4vw,44px); top:50%; }.message-stage h2 { font-size:clamp(2.3rem,7vw,4.3rem); }.message-stage h2 span { display:block; margin-top:.25em; color:#a9dcff; font-size:.52em; line-height:1.05; }.surprise-video video { display:block; width:100%; max-height:66vh; margin:28px auto 0; border:2px solid #a7dcff9c; border-radius:18px; background:#020817; box-shadow:0 16px 42px #0009; }
    .page-doodle { display:none!important; }
    .page-cat { display:block; width:clamp(76px,15vw,108px); margin:18px auto -3px; border:3px solid #bde5ff; border-radius:17px; box-shadow:0 8px 20px #0008; object-fit:cover; }.ready-cat { width:clamp(100px,20vw,135px); margin:22px auto -5px; border-color:#ffd982; transform:rotate(3deg); }
    @keyframes fall { to { transform:translate(var(--x),110vh) rotate(720deg); opacity:0; } }
    @keyframes bob { 50% { transform:translateY(-8px) rotate(-2deg); } }
    @keyframes blow { 30% { transform:scale(.9) translateX(12px); } 100% { transform:scale(.96); opacity:.72; } }
    @keyframes flicker { to { transform:translateX(-50%) scaleY(1.14) rotate(2deg); opacity:.82; } } @keyframes extinguish { 35% { transform:translateX(-50%) translateX(22px) scaleX(.35); opacity:.8; } 100% { transform:translateX(-50%) translateX(34px) scale(.05); opacity:0; } } @keyframes smoke { to { transform:translate(var(--sx),-95px) scale(2.7); opacity:0; } }
    @keyframes appear { from { opacity:0; transform:translateY(12px) scale(.98); } to { opacity:1; transform:none; } }
    @keyframes swim { 50% { transform:translateX(11px) rotate(5deg); } }
    @media (prefers-reduced-motion:reduce) { .cake { animation:none; } }
  </style>
</head>
<body>
  <div class="orbit o1"></div><div class="orbit o2"></div>
  <main>
    <section class="card" aria-label="Birthday greeting">
      <div class="screen active" id="birthday">
      <span class="page-doodle doodle-happy" aria-hidden="true"></span>
      <p class="eyebrow">A little celebration, just for you</p>
      <h1>Happy<span>Birthday!</span></h1>
      <img class="page-cat" src="🙏🏻🧕🏻👼🏻👶🏻.jpeg" alt="A cat saying Salam-meowlekum" />
      <div class="cake" id="cake" aria-hidden="true"><span class="cake-base">🎂</span><span class="candles">🕯️🕯️🕯️</span></div>
      <p class="message">May your year ahead be full of bright surprises, beautiful moments, and every reason to smile.</p>
      <button type="button" id="celebrate">Make a wish ✨</button>
      <p class="from">With lots of love</p>
      </div>
      <div class="screen" id="question">
        <span class="page-doodle doodle-question" aria-hidden="true"></span>
        <p class="eyebrow">One more little thing…</p>
        <p class="dory"><span aria-hidden="true">🐠</span>Dory says: just keep swimming… toward “Yes!”</p>
        <p class="question">I have something for u<br>do u wanna see?</p>
        <div class="choices"><button type="button" class="yes" id="yes">Yes! ✨</button><button type="button" id="no">No</button></div>
      </div>
      <div class="screen" id="dare">
        <span class="page-doodle doodle-dare" aria-hidden="true"></span>
        <p class="eyebrow">Excuse me?!</p><p class="question">How dare u</p>
        <img class="mad-cat" id="madCat" src="scoobert-mad-cat.png" alt="A very displeased cat — click for cats" />
        <button type="button" id="back">Go back</button>
      </div>
      <div class="screen" id="letter">
        <span class="page-doodle doodle-letter" aria-hidden="true"></span>
        <article class="royal-letter" aria-label="A birthday letter">
          <span class="doodle star" aria-hidden="true">✦</span><span class="doodle moon" aria-hidden="true">☾</span><span class="doodle heart" aria-hidden="true">♡</span><span class="doodle line" aria-hidden="true">⌁⌁⌁</span>
          <p class="letter-kicker">A royal birthday letter</p>
          <h2>HAPPY BIRTHDAY<br>to my FAVOURTIE person</h2>
          <p>You’ve always been someone very important to me, like all the stars in the sky yet I found the brightest one out of all.</p>
          <p>I hope this year brings everything you ever wanted and you smile as bright as the morning sky and as wide as the sky. Your smile may only dim when NASA can see light in black hole.</p>
          <p>Be happy, there always someone cheering for you.</p>
          <p class="signature">Happy birthday Zahid</p>
          <button class="seal" id="seal" type="button" aria-label="Open the royal seal">Z</button>
        </article>
      </div>
      <div class="screen" id="final">
        <span class="page-doodle doodle-final" aria-hidden="true"></span>
        <div class="final-note"><p class="eyebrow">The royal seal has opened</p><h2>For Zahid</h2><p>May all your brightest wishes find their way to you. Happy birthday.</p>
          <div class="photo-gallery"><button class="photo-button cat-button" type="button" data-cat="zoro-orange-cat.jpeg" aria-label="Zoro — launch orange cat confetti"><img src="zahid-cat-1.jpeg" alt="Zahid holding an orange cat" /><span class="photo-name">Zoro</span></button><button class="photo-button cat-button" type="button" data-cat="zuri-black-cat.jpeg" aria-label="Zuri — launch black cat confetti"><img src=""zuri.jpeg"" alt="Zahid cuddling a black cat" /><span class="photo-name">Zuri</span></button></div>
          <button class="seal small-seal" id="aSeal" type="button" aria-label="Start again">A</button>
        </div>
      </div>
      <div class="screen" id="surpriseMenu">
        <div class="surprise-menu">
          <p class="eyebrow">one more tiny adventure</p><h2>pick a letter</h2><p>I made a few more things for you.</p>
          <div class="surprise-letters"><button class="surprise-letter" id="openGallery" type="button">A</button><button class="surprise-letter" id="openSurprise" type="button">H</button><button class="surprise-letter" id="openMessage" type="button">I</button></div>
        </div>
      </div>
      <div class="screen" id="galleryScreen">
        <div class="surprise-gallery"><div class="gallery-heading"><div><p class="eyebrow">a few of my favourites</p><h2>little moments</h2></div><button class="surprise-letter" id="galleryNext" type="button" aria-label="Continue">H</button></div><div id="surpriseGrid" class="surprise-grid"></div></div>
      </div>
      <div class="screen" id="lastSurprise"><div class="surprise-stage"><p class="eyebrow">wait for it</p><h2>one last surprise</h2><button class="surprise-letter" id="lastNext" type="button" aria-label="Continue" style="margin-top:36px">I</button></div></div>
      <div class="screen" id="lastMessage"><div class="surprise-stage message-stage"><p class="eyebrow">okay, seriously</p><h2>ready right?<span>u better like it or i will kill you</span></h2><img class="page-cat ready-cat" src="Cat.jpeg" alt="A determined cat holding a knife" /><button class="seal" id="messageNext" type="button" aria-label="Open final video" style="margin-top:36px">D</button></div></div>
      <div class="screen" id="videoScreen"><div class="surprise-video"><p class="eyebrow">the final surprise</p><h2>for you ✦</h2><video id="surpriseVideo" controls playsinline preload="metadata">Your browser does not support the video tag.</video><p>Press play whenever you’re ready.</p></div></div>
    </section>
  </main>
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged photo"><img id="lightboxImage" alt="" /></div>
  <div class="surprise-lightbox" id="surpriseLightbox" role="dialog" aria-modal="true" aria-label="Enlarged gallery image"><button class="lightbox-control lightbox-close" id="surpriseClose" type="button" aria-label="Close">×</button><button class="lightbox-control lightbox-prev" id="surprisePrev" type="button" aria-label="Previous">‹</button><figure><img id="surpriseLightboxImage" alt=""><figcaption id="surpriseCaption"></figcaption></figure><button class="lightbox-control lightbox-next" id="surpriseNext" type="button" aria-label="Next">›</button></div>
  <script>
    function burst(count=60){ for(let i=0;i<count;i++){ const p=document.createElement('span'); p.className='fries'; p.textContent='🍟'; p.style.left=Math.random()*100+'vw'; p.style.setProperty('--x',(Math.random()-.5)*260+'px'); p.style.setProperty('--d',(1.8+Math.random()*1.8)+'s'); p.style.transform='rotate('+Math.random()*360+'deg)'; document.body.append(p); setTimeout(()=>p.remove(),4000); } }
    function catBurst(count=55){ for(let i=0;i<count;i++){ const p=document.createElement('span'); p.className='fries'; p.textContent='🐈'; p.style.left=Math.random()*100+'vw'; p.style.setProperty('--x',(Math.random()-.5)*260+'px'); p.style.setProperty('--d',(1.8+Math.random()*1.8)+'s'); p.style.transform='rotate('+Math.random()*360+'deg)'; document.body.append(p); setTimeout(()=>p.remove(),4000); } }
    function catStickerBurst(source,count=18){ for(let i=0;i<count;i++){ const p=document.createElement('img'); p.className='cat-sticker'; p.src=source; p.alt=''; p.style.left=Math.random()*100+'vw'; p.style.setProperty('--x',(Math.random()-.5)*260+'px'); p.style.setProperty('--d',(4.2+Math.random()*2.2)+'s'); p.style.transform='rotate('+Math.random()*360+'deg)'; document.body.append(p); setTimeout(()=>p.remove(),7000); } }
    function smokeBurst(){ const cake=document.querySelector('#cake').getBoundingClientRect(); for(let i=0;i<11;i++){ const p=document.createElement('i'); p.className='smoke'; p.style.left=(cake.left+cake.width*.42+Math.random()*cake.width*.2)+'px'; p.style.top=(cake.top+8+Math.random()*16)+'px'; p.style.setProperty('--sx',(28+Math.random()*74)+'px'); document.body.append(p); setTimeout(()=>p.remove(),1800); } }
    function show(id){ document.querySelectorAll('.screen').forEach(s=>s.classList.toggle('active',s.id===id)); }
    document.querySelector('#celebrate').addEventListener('click',()=>{ document.querySelector('#cake').classList.add('blown'); smokeBurst(); burst(); setTimeout(()=>show('question'),1200); });
    document.querySelector('#no').addEventListener('click',()=>show('dare'));
    document.querySelector('#back').addEventListener('click',()=>show('question'));
    document.querySelector('#madCat').addEventListener('click',()=>catBurst());
    document.querySelector('#yes').addEventListener('click',()=>{ burst(100); show('letter'); });
    document.querySelector('#seal').addEventListener('click',()=>{ burst(70); show('final'); });
    document.querySelector('#aSeal').addEventListener('click',()=>window.location.href='gallery.html');
    const lightbox=document.querySelector('#lightbox'), lightboxImage=document.querySelector('#lightboxImage');
    document.querySelectorAll('.cat-button').forEach(button=>button.addEventListener('click',()=>catStickerBurst(button.dataset.cat)));
    /* Zuri and Zoro photos + their matching confetti images. */
    const catCards=document.querySelectorAll('.cat-button');
    const zuriPortrait='file:///C:/Users/Shudhi%20Agarwal/OneDrive/Pictures/Screenshots/zahid%20zuri.jpeg';
    const zuriConfetti='file:///C:/Users/Shudhi%20Agarwal/OneDrive/Pictures/Screenshots/zuri.jpeg';
    const zoroPortrait='file:///C:/Users/SHUDHI~1/AppData/Local/Temp/codex-clipboard-39bdc9f0-7875-4f26-91f4-3239ca7baab2.jpg';
    const zoroConfetti='file:///C:/Users/SHUDHI~1/AppData/Local/Temp/codex-clipboard-e75b6063-d799-4967-b087-2124a51a3433.jpg';
    if(catCards.length>=2){
      catCards[0].dataset.cat=zoroConfetti; catCards[0].querySelector('img').src=zoroPortrait; catCards[0].querySelector('img').alt='Zahid holding Zoro';
      catCards[1].dataset.cat=zuriConfetti; catCards[1].querySelector('img').src=zuriPortrait; catCards[1].querySelector('img').alt='Zahid holding Zuri';
    }
    lightbox.addEventListener('click',()=>lightbox.classList.remove('open'));
    setTimeout(()=>burst(55),350);

    /* PERSONALISE HERE: put images in a folder beside this index.html and update these paths/captions. */
    const galleryImages = [
      { src:'images/image1.jpg', text:'Write your caption for image 1 here.' },
      { src:'images/image2.jpg', text:'Write your caption for image 2 here.' },
      { src:'images/image3.jpg', text:'Write your caption for image 3 here.' },
      { src:'images/image4.jpg', text:'Write your caption for image 4 here.' }
    ];
    const finalVideo = 'videos/final-video.mp4';
    const surpriseGrid=document.querySelector('#surpriseGrid'), surpriseLightbox=document.querySelector('#surpriseLightbox'); let surpriseIndex=0;
    galleryImages.forEach((item,index)=>{ const photo=document.createElement('button'); photo.type='button'; photo.className='surprise-photo'; photo.innerHTML=`<img src="${item.src}" alt="${item.text}"><span>${item.text}</span>`; photo.addEventListener('click',()=>openSurpriseLightbox(index)); surpriseGrid.append(photo); });
    function openSurpriseLightbox(index){ surpriseIndex=(index+galleryImages.length)%galleryImages.length; const item=galleryImages[surpriseIndex]; document.querySelector('#surpriseLightboxImage').src=item.src; document.querySelector('#surpriseLightboxImage').alt=item.text; document.querySelector('#surpriseCaption').textContent=item.text; surpriseLightbox.classList.add('open'); document.body.style.overflow='hidden'; }
    function closeSurpriseLightbox(){ surpriseLightbox.classList.remove('open'); document.body.style.overflow=''; }
    document.querySelector('#surpriseClose').addEventListener('click',closeSurpriseLightbox); document.querySelector('#surprisePrev').addEventListener('click',()=>openSurpriseLightbox(surpriseIndex-1)); document.querySelector('#surpriseNext').addEventListener('click',()=>openSurpriseLightbox(surpriseIndex+1)); surpriseLightbox.addEventListener('click',event=>{if(event.target===surpriseLightbox)closeSurpriseLightbox();});
    document.addEventListener('keydown',event=>{if(!surpriseLightbox.classList.contains('open'))return;if(event.key==='Escape')closeSurpriseLightbox();if(event.key==='ArrowLeft')openSurpriseLightbox(surpriseIndex-1);if(event.key==='ArrowRight')openSurpriseLightbox(surpriseIndex+1);});
    document.querySelector('#openGallery').addEventListener('click',()=>show('galleryScreen')); document.querySelector('#openSurprise').addEventListener('click',()=>show('lastSurprise')); document.querySelector('#openMessage').addEventListener('click',()=>show('lastMessage')); document.querySelector('#galleryNext').addEventListener('click',()=>show('lastSurprise')); document.querySelector('#lastNext').addEventListener('click',()=>show('lastMessage')); document.querySelector('#messageNext').addEventListener('click',()=>show('videoScreen')); document.querySelector('#surpriseVideo').src=finalVideo;
    const requestedScreen=new URLSearchParams(window.location.search).get('screen'); if(requestedScreen && document.querySelector('#'+requestedScreen)) show(requestedScreen);
  </script>
  
</body>
